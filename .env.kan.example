# Copy this file to .env and replace every REPLACE_ME value.
# Generate both secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=REPLACE_ME_WITH_A_64_CHARACTER_HEX_VALUE
BETTER_AUTH_SECRET=REPLACE_ME_WITH_A_DIFFERENT_64_CHARACTER_HEX_VALUE

# Public DNS hostname only; do not include https:// or a trailing slash.
KAN_HOSTNAME=kan.example.com

# Optional Compose namespace. Change this when hosting multiple copies.
COMPOSE_PROJECT_NAME=kan-offline-trello

# Keep sign-up open only while creating the first local administrator account.
# Change to true immediately afterward and recreate the web container.
NEXT_PUBLIC_DISABLE_SIGN_UP=false

# Email remains unavailable until SMTP is configured. See the upstream
# .env.example for the SMTP variables, then change this to false.
NEXT_PUBLIC_DISABLE_EMAIL=true

# Optional comma-separated login domains, for example: example.org,example.net
BETTER_AUTH_ALLOWED_DOMAINS=

# Optional deployment settings.
DATA_ROOT=./data
# Directory containing the extracted Trello export. Docker mounts this exact
# directory read-only at /trello-export inside the importer container.
TRELLO_EXPORT_DIR=./imports/trello-export
LOG_LEVEL=info
